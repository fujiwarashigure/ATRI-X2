# Copy this file to .env or set these variables in your OS environment.
# Variables in .env are also available to LLM shell commands.

# Provider API keys
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Platform secrets
QQOFFICIAL_CLIENT_SECRET=
QQONEBOT_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=

# Web tools
JINA_API_KEY=
WEB_EXTRACT_PROXY=
# web_search 通道密钥（可留空：Firecrawl / Keenable 免注册通道不需要 key）
# 通道顺序与自定义通道在 services.toml 的 [web_search] 里配置（桌面端「模型 → 搜索服务」）
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
KEENABLE_API_KEY=
EXA_API_KEY=
# 覆盖搜索通道顺序（逗号分隔，例如 firecrawl,keenable）
WEB_SEARCH_ENGINES=

# CLI remote client/server tokens
ATRIX_CLI_LOCAL_TOKEN=
ATRIX_CLI_WINDOWS_TOKEN=

# Atrinis tokens
ATRINIS_HOME_TOKEN=
ATRINIS_HOME_TOKEN_ALT=
