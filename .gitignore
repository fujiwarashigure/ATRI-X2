# Python 构建/缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# 只忽略仓库根的构建产物：atri_x/dist/ 是安装器/快捷方式的源码包，不能被 dist/ 误伤
/build/
/dist/
/deploy/dist/
*.egg-info/
.eggs/
.venv/
venv/

# 测试与覆盖率
.pytest_cache/
.coverage
htmlcov/
*.cover

# 测试临时目录（统一用仓库内前缀目录；不要用系统 tempfile）
tests/_tmp*/
tests/_probe*/
tests/.probe*/
tests/.probe2*/
tests/.tmp-*/
tests/probe-*/
tests/__pycache__/

# 运行期数据、日志与部署产物
data/
*.db
*.db-wal
*.db-shm
logs/
run/
deploy/reports/

# 本机私有配置（不要提交真实 API Key）
.env
# 内嵌的 Hook 插件环境变量模板是随代码分发的资产，不是本机私有配置
!atri_x/config/assets_data/plugins/.env
app.local.toml
*.local.toml

# 编辑器
.vscode/
.idea/
*.swp

# Agent / 测试在仓库根部留下的调试产物（一律不入库）
.sig_*.txt
*_v.log
*_v.err
# 输入法（如搜狗）会往进程 cwd 写日志，不是本仓库产物
debug.log
tests/_probe.txt
tmp_*/
tmp_*
tmp_atrix_test/
tmp_cfg_test/
tmp_sqlite_test/
# 点开头的临时文件/目录；不会误伤 .github / .gitignore / .gitattributes
.*.txt
.*.log
.*.err
.*-test*/
.*test-*/
.probe*/
.probe2*/
.tmp*/
.fo*.txt
.commitmsg.tmp

# 打包用的内置运行时（由 packaging/assemble_kernel.py 从本机 DSH 安装组装，体积大，不入库）
/runtime/

# 内置 draw.io 渲染器解包目录（约 400 MB 的构建材料，不入库；构建用 --with-drawio 指定）
/packaging/vendor/drawio/

# 随包 draw.io 技能的本地运行产物（导出图/渲染 profile/临时输入；pack.json 摘要不收它们）
/drawio_pack/skills/drawio-skill/out/
