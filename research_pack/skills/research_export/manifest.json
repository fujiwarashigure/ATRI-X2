{
  "schema": "atrix-research/manifest/1",
  "tool": "export",
  "skill": "research_export",
  "title": "",
  "description": "交付物生成：装配研究报告（方法/PRISMA/证据表/局限），或把正文与报告导出为Markdown/HTML/DOCX/PDF；缺第三方库时降级并明确说明。",
  "risk": "low",
  "tags": [
    "research",
    "academic",
    "export"
  ],
  "timeout_seconds": 240,
  "parameters": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "report",
          "export",
          "pdf",
          "all"
        ],
        "description": "report=只装配报告；export=导出已有稿件；pdf=抽取 PDF 全文；all=报告+导出。"
      },
      "run": {
        "type": "string",
        "description": "运行 id；'latest' 表示最近一次。缺省时多数工具要求显式给出。"
      },
      "formats": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "导出格式子集，默认 ['md','html','docx','pdf']。"
      },
      "pdf_dir": {
        "type": "string",
        "description": "pdf 动作的源目录。"
      }
    }
  },
  "args": {
    "action": "--action",
    "run": "--run",
    "formats": "--formats",
    "pdf_dir": "--pdf-dir"
  }
}
