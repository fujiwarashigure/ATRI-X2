# ATRI-X external watchdog settings. Copy to watchdog.env and edit.
# The watchdog only checks the independent /live endpoint and restarts the
# single ATRI-X container with cooldown and restart limits.
#
# 由 systemd timer 每分钟执行 atri_x_watchdog.py；本文件用 EnvironmentFile 注入。
# 注意 systemd 的 EnvironmentFile **不做 shell 展开**，值里不要写 $(...) 或 ${...}。

# WATCHDOG_HEALTH_URL=http://127.0.0.1:32171/live
# WATCHDOG_READY_URL=http://127.0.0.1:32171/ready
# WATCHDOG_HEALTHZ_URL=http://127.0.0.1:32171/healthz
# 单次 HTTP 探测超时秒数（上游硬编码 5s，Python 版可调）
# WATCHDOG_HTTP_TIMEOUT=5

# Consecutive /live failures before a restart is considered.
WATCHDOG_FAILURE_THRESHOLD=3
# /live is healthy but /ready keeps failing: only alert (never restart).
# Requires WATCHDOG_WEBHOOK_URL; the cooldown prevents alert storms.
WATCHDOG_READY_ALERT_THRESHOLD=3
WATCHDOG_READY_ALERT_COOLDOWN_SECONDS=3600
# Minimum seconds between automatic restarts.
WATCHDOG_COOLDOWN_SECONDS=300
# Maximum automatic restarts inside WATCHDOG_WINDOW_SECONDS.
WATCHDOG_MAX_RESTARTS=3
# Rolling window for restart limits.
WATCHDOG_WINDOW_SECONDS=21600
# Diagnostics directory and state directory (defaults are under deploy/).
# WATCHDOG_DIAG_DIR=/opt/atri-x/deploy/diagnostics
# WATCHDOG_STATE_DIR=/opt/atri-x/deploy/watchdog-state
# If ATRIX_OPS_TOKEN is configured, set the same token here so the
# diagnostics bundle can query /tasks and /metrics.
# WATCHDOG_OPS_TOKEN=请替换为随机长字符串
# 回滚/诊断用重启原因文件；默认是 deploy/data/run/atri-x/last_restart_reason。
# WATCHDOG_RESTART_REASON_FILE=/opt/atri-x/deploy/data/run/atri-x/last_restart_reason
# Optional webhook for restart/paused notifications.
# WATCHDOG_WEBHOOK_URL=https://example.invalid/atri-x-alert
# Set to 1 to only log/diagnose without restarting.
# WATCHDOG_DRY_RUN=0
