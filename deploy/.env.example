# ============================================================
# ATRI-X Python 版部署环境变量
# 复制为 .env 后填写；.env 会被 docker compose 注入容器，同时也是
# ATRI-X 读取的进程环境变量（优先级高于配置目录下的 .env）。
# 权限建议：chmod 600 .env
#
# 注意：Compose env_file 注入的是 ATRI-X 进程环境，Shell / Hook 子进程
# 也可能继承这里的全部变量。面向群聊用户开放工具时，不要只依赖
# “容器不是 root”来保护 API Key；详见部署 README 第 11 节。
#
# 与上游 Go 版 .env.example 的差异（键名逐条映射见 deploy/README.md）：
#   GO_VERSION / GOPROXY / GO_BASE_IMAGE / RUNTIME_BASE_IMAGE /
#   ATRIX_BUILD_TARGET / ATRIX_GO_BINARY 全部删除 —— Python 版没有编译步骤，
#   也没有容器内编译 Skill 的 go-runtime 目标；由 PY_BASE_IMAGE 取代。
#   新增 ATRIX_DATA_VOLUME（named volume 名）与 ATRIX_CONFIG_FILE。
# ============================================================

# ---------- Compose 项目名（保持与 systemd 单元一致）----------
COMPOSE_PROJECT_NAME=atri-x

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- 配置路径（可选） ----------
# 不设置时按 XDG_CONFIG_HOME=/data/config 找 /data/config/atri-x/*.toml。
# 只有把配置放到非标准位置时才需要显式指定（对应 atri_x.config.loader
# 的 ATRIX_CONFIG_FILE）。
# ATRIX_CONFIG_FILE=/data/config/atri-x/app.toml

# ---------- 独立运维健康接口 ----------
# 仅在容器内部 / 宿主机回环地址可访问：
#   /live   始终公开：进程是否仍在运行（不判断心跳/平台/模型）
#   /ready  始终公开：进程初始化、数据目录可写、调度心跳未过期；平台/模型故障不影响
#   /healthz 汇总状态；未设置 ATRIX_OPS_TOKEN 且未显式允许无鉴权时不注册。
#            平台/模型故障为 degraded，调度心跳过期 /ready 为 not_ready
# Compose 已把 32171 只映射到宿主机 127.0.0.1；原生部署可改成 127.0.0.1:32171。
ATRIX_HEALTH_ADDR=0.0.0.0:32171
ATRIX_HEALTH_LIVE_STALE_SECONDS=90
# /tasks、/metrics、/diagnostics、/plugins/* 和 /healthz 的访问 token。
# 未设置时敏感运维接口默认不注册，只保留 /live 和 /ready；
# watchdog 用 WATCHDOG_OPS_TOKEN 填同一个值。
# ATRIX_OPS_TOKEN=请替换为随机长字符串
# 仅排障用：显式允许无鉴权暴露敏感运维接口（必须只用于回环/可信网络）。
# ATRIX_OPS_ALLOW_UNAUTHENTICATED=1
# watchdog 重启原因文件；默认按 XDG_RUNTIME_DIR 读取 /data/run/atri-x/last_restart_reason
# ATRIX_RESTART_REASON_FILE=/data/run/atri-x/last_restart_reason

# ---------- 镜像 / 构建参数（docker compose 变量） ----------
# ATRIX_VERSION 应与 deploy/VERSION 保持一致（deploy/VERSION 是默认版本号的单点来源；
# build-push.py / prepare-offline.py 在未显式指定时会读取它）
ATRIX_IMAGE=atri-x:0.9.0
ATRIX_VERSION=0.9.0
# named volume 名；数据（配置 / SQLite / 日志 / 媒体）全在这里面
ATRIX_DATA_VOLUME=atri_x_data
# 基础镜像；官方 python:3.14-slim 存在（= 3.14-slim-bookworm）。
# 需要国内加速 / pin digest 时覆盖，例如：
#   PY_BASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/python:3.14-slim
# 该 tag 拉不动时退回 3.13-slim（代码只依赖标准库，3.11~3.14 均可运行）。
PY_BASE_IMAGE=python:3.14-slim
# 可选：给运行镜像追加更多系统命令。Python 版运行时不依赖任何系统命令，
# 默认列表为空（上游 Go 版默认装了一大串 CLI 工具）。
# EXTRA_TOOLS=curl tini
# 可选：apt 镜像主机名（仅当 EXTRA_TOOLS 非空时需要）
# APT_MIRROR=mirrors.ustc.edu.cn

# ---------- 内置 DSH（DeepSeek Harness）----------
# 镜像里的 DSH 由 ATRI-X 以 `dsh --profile acp` 的 stdio 子进程调用，不开端口。
# DSH 版本必须与 atri_x/agent/dsh 的 ACP 客户端匹配，默认锁死 0.2.0-rc.2。
# NODE_BASE_IMAGE 提供 node 24 运行时（Debian 12 / glibc，不能换成 alpine）。
NODE_BASE_IMAGE=node:24-bookworm-slim
DSH_VERSION=0.2.0-rc.2
# 可选：npm 源（国内加速）；默认官方源
# DSH_NPM_REGISTRY=https://registry.npmmirror.com
# DSH 自己的模型凭据直接复用上面的 DEEPSEEK_API_KEY（dsh-credentials-local 继承环境变量），
# 因此不需要额外一份 Key；需要独立额度时再给 DSH 单独配凭据。

# ---------- LLM Provider 密钥 ----------
# services.toml（旧部署 providers.toml）中 api_key_env 指向的名字必须与此处一致
DEEPSEEK_API_KEY=sk-请替换
OPENAI_API_KEY=sk-请替换
# 可选：生图服务 API Key（services.toml 的 [image_generation].api_key_env 默认读这个）
# 建议使用与 LLM 分开的 Key，并在中转站设置额度/限速；不要给群聊用户无限生图额度。
IMAGE_API_KEY=sk-请替换

# ---------- CLI 远程 WebSocket 服务端 token ----------
# 对应 app.toml 的 [platform.cli.server.tokens]
# 客户端 client_id 使用 local 时即为超级管理员（security.superadmins.cli=["local"]）
ATRIX_CLI_LOCAL_TOKEN=请替换为随机长字符串
# ATRIX_CLI_WINDOWS_TOKEN=请替换为随机长字符串

# ---------- Atrinis 事件入口 token ----------
# 对应 atrinis.toml 的 [tokens.home]
ATRINIS_HOME_TOKEN=请替换为随机长字符串

# ---------- 平台密钥（按需启用） ----------
# QQ 官方机器人
# QQOFFICIAL_CLIENT_SECRET=请替换
# QQ OneBot
# QQONEBOT_ACCESS_TOKEN=请替换
# Telegram
# TELEGRAM_BOT_TOKEN=请替换
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080

# ---------- 媒体对象存储（可选） ----------
# app.toml [file_delivery] backend = "s3" / "hybrid" 时使用
# ATRIX_S3_ACCESS_KEY_ID=请替换
# ATRIX_S3_SECRET_ACCESS_KEY=请替换
